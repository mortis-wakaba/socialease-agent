# SocialEase local/Docker Compose environment example.
# Copy this file to .env for local development. Do not commit .env.
# For real-user pilot environments, start from .env.staging.example or
# .env.production.example and store secrets in the deployment platform.

# Optional LLM support. The app remains usable when disabled.
SOCIALEASE_APP_VERSION=dev
LLM_ENABLED=false
OUTPUT_GUARDRAIL_LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30

# Browser-visible backend URL used by the Next.js frontend build.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SOCIALEASE_AUTH_MODE=demo
NEXT_PUBLIC_SOCIALEASE_ENABLE_SIGNUP=true
NEXT_PUBLIC_SOCIALEASE_TOKEN_STORAGE=localStorage

# Browser origins allowed by the backend. Use comma-separated origins when needed.
SOCIALEASE_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Authentication.
# demo: local demo mode. Optional X-Demo-User-Id can simulate the current user.
# production: requires Authorization: Bearer <signed token>.
SOCIALEASE_AUTH_MODE=demo
SOCIALEASE_AUTH_TOKEN_SECRET=
# Backend-enforced public signup switch. Keep true for local demo; set false for pilot.
SOCIALEASE_ENABLE_SIGNUP=true
# Optional closed-pilot signup gates used when SOCIALEASE_ENABLE_SIGNUP=false.
SOCIALEASE_SIGNUP_ALLOWED_EMAILS=
SOCIALEASE_SIGNUP_INVITE_CODES=
# Optional HttpOnly cookie token transport for staging/pilot auth.
SOCIALEASE_AUTH_COOKIE_ENABLED=false
SOCIALEASE_AUTH_COOKIE_SECURE=true

# Direct state-changing APIs keep demo behavior by default.
# In production auth mode this is automatically enforced unless explicitly set false.
SOCIALEASE_ENFORCE_DIRECT_ACTION_CONSENT=

# Optional Calendar MCP. Empty uses the explicitly labeled in-process demo Provider.
# Run `make dev-calendar-mcp` and set this URL to exercise real MCP Streamable HTTP calls.
SOCIALEASE_CALENDAR_MCP_URL=
SOCIALEASE_CALENDAR_MCP_HOST=127.0.0.1
SOCIALEASE_CALENDAR_MCP_PORT=8010
SOCIALEASE_CALENDAR_MCP_SERVER_TRANSPORT=streamable-http

# Rate limiting / reliability knobs for future pilot hardening.
# 0 keeps local development unrestricted. Set a positive value for pilot deployments.
SOCIALEASE_RATE_LIMIT_PER_MINUTE=0
SOCIALEASE_AUTH_RATE_LIMIT_PER_MINUTE=0
LLM_MAX_CONCURRENCY=4
LLM_CONCURRENCY_WAIT_SECONDS=0.25
SOCIALEASE_SLOW_REQUEST_MS=1000
SOCIALEASE_REDIS_URL=
SOCIALEASE_REQUIRE_REDIS=false
# Optional backend-container override; host-side development normally uses localhost.
SOCIALEASE_DOCKER_REDIS_URL=redis://redis:6379/0
ROLEPLAY_SESSION_CONTEXT_TTL_SECONDS=3600
ROLEPLAY_PAUSED_CONTEXT_TTL_SECONDS=86400
ROLEPLAY_CONTEXT_MAX_INPUT_TOKENS=10000
ROLEPLAY_RECENT_MIN_MESSAGES=12
ROLEPLAY_RECENT_TARGET_MESSAGES=16
ROLEPLAY_RECENT_MAX_MESSAGES=20
ROLEPLAY_COMPACT_TARGET_TOKENS=1000
ROLEPLAY_COMPACT_TRIGGER_RATIO=0.75
ROLEPLAY_REDIS_SOCKET_TIMEOUT_SECONDS=0.5
ROLEPLAY_TOKENIZER_BACKEND=auto
ROLEPLAY_TOKENIZER_MODEL=
WORKSHEET_DRAFT_TTL_SECONDS=3600
SUPPORT_SEARCH_TTL_SECONDS=1800
SOCIALEASE_RATE_LIMIT_BACKEND=local
SOCIALEASE_LLM_CONCURRENCY_BACKEND=local

# Persistence. SQLite remains the local demo backend.
# PostgreSQL is the production/pilot target; use an isolated database for integration tests.
# Local backend default; Docker Compose still sets SOCIALEASE_DB_PATH=/data/socialease.db.
SOCIALEASE_DATABASE_URL=
SOCIALEASE_DB_PATH=
SOCIALEASE_SQLITE_TIMEOUT_SECONDS=10
# Optional in demo mode; production auth requires a URL-safe Base64 encoded 32-byte key.
SOCIALEASE_CONVERSATION_CONTENT_KEY=
SOCIALEASE_CONVERSATION_CONTENT_KEY_VERSION=v1
SOCIALEASE_BACKUP_DIR=./backups

# Privacy and retention settings.
SOCIALEASE_TRACE_RETENTION_DAYS=30
SOCIALEASE_PROTOCOL_RETENTION_DAYS=30
SOCIALEASE_ABANDONED_PLAN_MINUTES=60

# Operational alert checks used by scripts/monitor_alerts.py.
SOCIALEASE_MONITOR_BASE_URL=http://127.0.0.1:8000
SOCIALEASE_ALERT_WEBHOOK_URL=
SOCIALEASE_ALERT_CRISIS_RUNS=5
SOCIALEASE_ALERT_FALLBACK_RUNS=20
SOCIALEASE_ALERT_RATE_LIMIT_HITS=20
SOCIALEASE_ALERT_LLM_CONCURRENCY_SATURATION=0
SOCIALEASE_ALERT_SLOW_REQUESTS=20
SOCIALEASE_ALERT_LATENCY_P95_MS=5000

# Optional PostgreSQL integration-test database.
POSTGRES_DB=socialease
POSTGRES_USER=socialease
POSTGRES_PASSWORD=socialease
SOCIALEASE_TEST_DATABASE_URL=postgresql+psycopg://socialease:socialease@localhost:5432/socialease
