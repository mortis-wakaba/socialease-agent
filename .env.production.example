# SocialEase production environment example.
# This project is not yet production-ready. Use this file as a checklist for
# future deployment planning, not as a claim that production runtime is complete.
# Store real values in a secret manager or deployment platform. Do not commit secrets.

# Backend / frontend connectivity.
NEXT_PUBLIC_API_BASE_URL=https://api.socialease.example.edu
NEXT_PUBLIC_SOCIALEASE_AUTH_MODE=production
NEXT_PUBLIC_SOCIALEASE_ENABLE_SIGNUP=false
NEXT_PUBLIC_SOCIALEASE_TOKEN_STORAGE=cookie
NEXT_PUBLIC_SOCIALEASE_SHOW_TRACE=false
NEXT_PUBLIC_SOCIALEASE_SHOW_DIAGNOSTICS=false
SOCIALEASE_CORS_ORIGINS=https://socialease.example.edu
SOCIALEASE_FRONTEND_DOMAIN=socialease.example.edu
SOCIALEASE_API_DOMAIN=api.socialease.example.edu
SOCIALEASE_TLS_CERT_DIR=/etc/socialease/certs

# Authentication.
# Replace the self-built HS256 JWT/session MVP with OIDC or managed identity before real launch.
SOCIALEASE_AUTH_MODE=production
SOCIALEASE_AUTH_TOKEN_SECRET=replace-with-long-random-secret
SOCIALEASE_ENABLE_SIGNUP=false
SOCIALEASE_SIGNUP_ALLOWED_EMAILS=
SOCIALEASE_SIGNUP_INVITE_CODES=
SOCIALEASE_AUTH_COOKIE_ENABLED=true
SOCIALEASE_AUTH_COOKIE_SECURE=true

# State-changing practice actions require consent.
SOCIALEASE_ENFORCE_DIRECT_ACTION_CONSENT=true

# Database.
# Production target is PostgreSQL. Run migrations and backup checks before deploy.
SOCIALEASE_DATABASE_URL=postgresql+psycopg://socialease:replace-password@db.example.edu:5432/socialease
SOCIALEASE_BACKUP_DIR=/secure/socialease-backups
SOCIALEASE_RESTORE_TEST_DATABASE_URL=postgresql+psycopg://socialease_restore:replace-password@db.example.edu:5432/socialease_restore_drill

# LLM provider.
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30

# Rate limiting / reliability.
SOCIALEASE_RATE_LIMIT_PER_MINUTE=60
SOCIALEASE_AUTH_RATE_LIMIT_PER_MINUTE=5
LLM_MAX_CONCURRENCY=4
LLM_CONCURRENCY_WAIT_SECONDS=0.25
SOCIALEASE_SLOW_REQUEST_MS=1000
SOCIALEASE_REDIS_URL=rediss://replace-with-upstash-or-cloud-redis
ROLEPLAY_SESSION_CONTEXT_TTL_SECONDS=3600
ROLEPLAY_PAUSED_CONTEXT_TTL_SECONDS=86400
ROLEPLAY_CONTEXT_MAX_INPUT_TOKENS=10000
ROLEPLAY_RECENT_MIN_MESSAGES=12
ROLEPLAY_RECENT_TARGET_MESSAGES=16
ROLEPLAY_RECENT_MAX_MESSAGES=20
ROLEPLAY_COMPACT_TARGET_TOKENS=1000
ROLEPLAY_COMPACT_TRIGGER_RATIO=0.75
ROLEPLAY_TOKENIZER_BACKEND=auto
ROLEPLAY_TOKENIZER_MODEL=
WORKSHEET_DRAFT_TTL_SECONDS=3600
SUPPORT_SEARCH_TTL_SECONDS=1800
SOCIALEASE_RATE_LIMIT_BACKEND=gateway
SOCIALEASE_LLM_CONCURRENCY_BACKEND=local
SOCIALEASE_NGINX_API_RATE=60r/m

# Privacy and retention.
SOCIALEASE_TRACE_RETENTION_DAYS=30
SOCIALEASE_PROTOCOL_RETENTION_DAYS=30
SOCIALEASE_ABANDONED_PLAN_MINUTES=60

# Operational alert checks.
SOCIALEASE_MONITOR_BASE_URL=https://api.socialease.example.edu
SOCIALEASE_SMOKE_FRONTEND_URL=https://socialease.example.edu
SOCIALEASE_SMOKE_TIMEOUT_SECONDS=5
SOCIALEASE_ALERT_WEBHOOK_URL=replace-with-alert-webhook
SOCIALEASE_ALERT_CRISIS_RUNS=5
SOCIALEASE_ALERT_FALLBACK_RUNS=20
SOCIALEASE_ALERT_RATE_LIMIT_HITS=20
SOCIALEASE_ALERT_LLM_CONCURRENCY_SATURATION=0
SOCIALEASE_ALERT_SLOW_REQUESTS=20
SOCIALEASE_ALERT_LATENCY_P95_MS=5000
