FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder

WORKDIR /app/frontend

ARG NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
ARG NEXT_PUBLIC_SOCIALEASE_AUTH_MODE=demo
ARG NEXT_PUBLIC_SOCIALEASE_ENABLE_SIGNUP=true
ARG NEXT_PUBLIC_SOCIALEASE_TOKEN_STORAGE=localStorage
ARG NEXT_PUBLIC_SOCIALEASE_SHOW_TRACE=false
ARG NEXT_PUBLIC_SOCIALEASE_SHOW_DIAGNOSTICS=false
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_SOCIALEASE_AUTH_MODE=$NEXT_PUBLIC_SOCIALEASE_AUTH_MODE
ENV NEXT_PUBLIC_SOCIALEASE_ENABLE_SIGNUP=$NEXT_PUBLIC_SOCIALEASE_ENABLE_SIGNUP
ENV NEXT_PUBLIC_SOCIALEASE_TOKEN_STORAGE=$NEXT_PUBLIC_SOCIALEASE_TOKEN_STORAGE
ENV NEXT_PUBLIC_SOCIALEASE_SHOW_TRACE=$NEXT_PUBLIC_SOCIALEASE_SHOW_TRACE
ENV NEXT_PUBLIC_SOCIALEASE_SHOW_DIAGNOSTICS=$NEXT_PUBLIC_SOCIALEASE_SHOW_DIAGNOSTICS

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS runner

WORKDIR /app/frontend
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
ARG NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
ARG NEXT_PUBLIC_SOCIALEASE_AUTH_MODE=demo
ARG NEXT_PUBLIC_SOCIALEASE_ENABLE_SIGNUP=true
ARG NEXT_PUBLIC_SOCIALEASE_TOKEN_STORAGE=localStorage
ARG NEXT_PUBLIC_SOCIALEASE_SHOW_TRACE=false
ARG NEXT_PUBLIC_SOCIALEASE_SHOW_DIAGNOSTICS=false
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_SOCIALEASE_AUTH_MODE=$NEXT_PUBLIC_SOCIALEASE_AUTH_MODE
ENV NEXT_PUBLIC_SOCIALEASE_ENABLE_SIGNUP=$NEXT_PUBLIC_SOCIALEASE_ENABLE_SIGNUP
ENV NEXT_PUBLIC_SOCIALEASE_TOKEN_STORAGE=$NEXT_PUBLIC_SOCIALEASE_TOKEN_STORAGE
ENV NEXT_PUBLIC_SOCIALEASE_SHOW_TRACE=$NEXT_PUBLIC_SOCIALEASE_SHOW_TRACE
ENV NEXT_PUBLIC_SOCIALEASE_SHOW_DIAGNOSTICS=$NEXT_PUBLIC_SOCIALEASE_SHOW_DIAGNOSTICS

COPY --from=builder --chown=node:node /app/frontend/.next/standalone ./
COPY --from=builder --chown=node:node /app/frontend/.next/static ./.next/static

# The production server only needs the Node.js runtime. Package managers belong
# in the builder stage and unnecessarily expand the runtime attack surface.
RUN rm -rf \
      /usr/local/lib/node_modules/npm \
      /usr/local/lib/node_modules/corepack \
    && rm -f \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/corepack \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg \
      /usr/local/bin/pnpm \
      /usr/local/bin/pnpx

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
