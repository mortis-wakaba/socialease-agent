# Optional LLM support. The app remains usable when disabled.
LLM_ENABLED=false
OUTPUT_GUARDRAIL_LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_JSON_MODE_ENABLED=true
LLM_REASONING_EFFORT=

# Local lightweight model for production intent routing and conversation
# compaction; hosted generation continues to use the provider above.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_PROVIDER=openai_compatible
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen3.5:4b
LOCAL_LLM_TIMEOUT_SECONDS=5
LOCAL_LLM_JSON_MODE_ENABLED=true
LOCAL_LLM_REASONING_EFFORT=none
LOCAL_LLM_RETRY_MAX_ATTEMPTS=1
LOCAL_LLM_MAX_CONCURRENCY=2
LOCAL_LLM_CONCURRENCY_WAIT_SECONDS=0.25
